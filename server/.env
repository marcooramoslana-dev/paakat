# ============================================================
#  Conexion a MySQL local (creada desde MySQL Workbench)
#  Formato: mysql+pymysql://USUARIO:CONTRASENA@HOST:PUERTO/paakat?charset=utf8mb4
#
#  IMPORTANTE: reemplaza USUARIO y CONTRASENA por los de tu
#  conexion de Workbench. Si tu contrasena tiene caracteres
#  especiales (@ : / ?), codificalos en URL (ej. @ -> %40).
# ============================================================
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/paakat?charset=utf8mb4

# Modelo CLIP zero-shot
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DEVICE=cpu
MIN_CONFIDENCE=0.30
TOP_K=3

# Seguridad (vacio = API sin API key)
API_KEY=

# Imagenes
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# CORS
CORS_ORIGINS=["*"]

DEBUG=false

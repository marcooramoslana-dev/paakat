# Conexion a MySQL (usar el nombre del servicio 'db' dentro de docker-compose)
DATABASE_URL=mysql+pymysql://paakat:paakat@localhost:3306/paakat?charset=utf8mb4

# Modelo CLIP zero-shot
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_DEVICE=auto
MIN_CONFIDENCE=0.30
TOP_K=3

# Seguridad (vacio = API sin API key)
API_KEY=

# Imagenes
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# CORS
CORS_ORIGINS=["*"]

DEBUG=false
